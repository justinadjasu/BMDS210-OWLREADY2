    <!-- http://purl.obolibrary.org/obo/GO_0005929 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0043226"/>
        <obo:IAO_0000115>A specialized eukaryotic organelle that consists of a filiform extrusion of the cell surface and of some cytoplasmic parts. Each cilium is largely bounded by an extrusion of the cytoplasmic (plasma) membrane, and contains a regular longitudinal array of microtubules, anchored to a basal body.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0072372</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>FMA:67181</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NIF_Subcellular:sao787716553</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Cilium</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>eukaryotic flagellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>microtubule-based flagellum</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>primary cilium</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>flagellum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0005929</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_chembl"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_drosophila"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_generic"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_pir"/>
        <rdfs:comment>Note that we deem cilium and microtubule-based flagellum to be equivalent. In most eukaryotic species, intracellular sub-components of the cilium, such as the ciliary base and rootlet, are located near the plasma membrane. In Diplomonads such as Giardia, instead, the same ciliary parts are located further intracellularly. Also, &apos;cilium&apos; may be used when axonemal structure and/or motility are unknown, or when axonemal structure is unusual. For all other cases, please refer to children of &apos;cilium&apos;. Finally, note that any role of ciliary proteins in sensory events should be captured by annotating to relevant biological process terms.</rdfs:comment>
        <rdfs:label>cilium</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005929"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A specialized eukaryotic organelle that consists of a filiform extrusion of the cell surface and of some cytoplasmic parts. Each cilium is largely bounded by an extrusion of the cytoplasmic (plasma) membrane, and contains a regular longitudinal array of microtubules, anchored to a basal body.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:cilia</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:curators</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:kmv</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>GOC:vw</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ISBN:0198547684</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:16824949</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:17009929</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>PMID:20144998</oboInOwl:hasDbXref>
    </owl:Axiom>
    


