        <oboInOwl:hasDbXref>Reactome:R-HSA-8848663</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>signaling receptor ligand activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>molecular_function</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>receptor agonist activity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0048018</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_chembl"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_drosophila"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_generic"/>
        <rdfs:label>receptor ligand activity</rdfs:label>
    </owl:Class>
