    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0055085">
        <obo:IAO_0000115>The process in which a solute is transported across a lipid bilayer, from one side of a membrane to the other.</obo:IAO_0000115>
        <oboInOwl:created_by>tb</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-10-21T13:22:47Z</oboInOwl:creation_date>
