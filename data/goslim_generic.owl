        <oboInOwl:hasDbXref>Reactome:R-HSA-9024630</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-9025007</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-9026001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-9026917</oboInOwl:hasDbXref>
