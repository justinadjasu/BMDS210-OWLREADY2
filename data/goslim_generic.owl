    <!-- http://purl.obolibrary.org/obo/GO_0002376 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0002376">
        <obo:IAO_0000115>Any process involved in the development or functioning of the immune system, an organismal system for calibrated responses to potential internal or invasive threats.</obo:IAO_0000115>
