    <!-- http://purl.obolibrary.org/obo/GO_0061007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0061007">
        <obo:IAO_0000115>A system process carried out by any of the organs or tissues of the hepaticobiliary system. The hepaticobiliary system is responsible for metabolic and catabolic processing of small molecules absorbed from the blood or gut, hormones and serum proteins, detoxification, storage of glycogen, triglycerides, metals and lipid soluble vitamins and excretion of bile. Included are the synthesis of albumin, blood coagulation factors, complement, and specific binding proteins.</obo:IAO_0000115>
        <oboInOwl:created_by>dph</oboInOwl:created_by>
        <oboInOwl:creation_date>2010-01-22T09:09:10Z</oboInOwl:creation_date>
