        <oboInOwl:hasExactSynonym>membrane transport</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>ATP hydrolysis coupled transmembrane transport</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0055085</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_chembl"/>
