    <!-- http://purl.obolibrary.org/obo/GO_0005215 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005215">
        <obo:IAO_0000115>Enables the directed movement of substances (such as macromolecules, small molecules, ions) into, out of or within a cell, accross or in between cells.</obo:IAO_0000115>
