        <oboInOwl:hasDbXref>GOC:dgf</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0005576 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005576">
        <obo:IAO_0000115>The space external to the outermost structure of a cell. For cells without external protective or external encapsulating structures this refers to space outside of the plasma membrane. This term covers the host cell environment outside an intracellular parasite.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Extracellular</oboInOwl:hasDbXref>
